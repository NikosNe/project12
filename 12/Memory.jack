/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {
     static Array ram;
     static Array heap;
     static int freeList, heap_size;

    /** Initializes the class. */
    function void init() {
        let ram = 0;
        let heap = 2048;
        let heap_size = 14335;
        let freeList = 2048;
        let heap[0] = 0;
        let heap[1] = heap_size - 2;
        return;
    }


    /** Returns the RAM value at the given address. */
    function int peek(int address) {
        return ram[address];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int address, int value) {
        let ram[address] = value;
        return;
    }

    function boolean is_enough_space(int total_block_size, int size) {
        if ((heap_size - total_block_size < size + 2)) {
            return false;
        }
        else {
            return true;
        }
    }

/** Finds an available RAM block of the given size and returns
 *  a reference to its base address. */
 function Array alloc(int size) {
        var int addr, total_block_size, new_size;
        var int test_index;
        let addr = 0;
        let test_index = 0;
        // The total size occupied by blocks
        let total_block_size = 0;
    // While there is still enough space in the heap
    while (Memory.is_enough_space(total_block_size, size) = true) {
        // addr + 1 holds the data size of the segment.
        do Output.printInt(Memory.peek(heap[addr + 1]));
        do Output.println();
        do Output.printString("here");
        if (Memory.peek(heap[addr + 1]) < size + 2) {
            // If the segment is not possible, we re-adjust
            // the total size occupied by blocks and look at the connected block
            let total_block_size = total_block_size + heap[addr + 1];
            let addr = Memory.peek(heap[addr]);
            do Output.printString("Address of the new block is ");
            do Output.printInt(addr);
            do Output.println();
        }
        else {
            // If the segment is possible,
            // decrease the available size of the segment by the given size plus the two overhead blocks.
            let new_size = heap[addr + 1] - size - 2;
            do Memory.poke(heap[addr + 1], new_size);
            // Find the new block’s top overhead field
            // The new block's base address should be right after where the chopped block ends.
            let freeList = freeList + addr + 1 + new_size;
            // Return it
            return freeList;
        }
        }
        return -1; // No available block found
}

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var int addr;
        let addr = 0;
        //We want to cast the o Array at the end of the freeList

        //traverse the linkedList
        //until we reach the element, whose first block is zero

        while (heap[addr] > 0) {
            let addr = heap[addr];
        }
        //Then we should change the zero value of this block to the base address of the o Array (i.e. set it equal to o.)
        //And finally change the first element of the o Array to 0.
        let heap[addr] = o;
        let o[0] = 0;
        return;
    }    
}
